<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Applications | Online Job Finder</title>
  <style>
    :root{font-family:Inter,Segoe UI,Arial,sans-serif;color:#1e293b;background:#f4f7fb}*{box-sizing:border-box}body{margin:0}.top{background:white;border-bottom:1px solid #e2e8f0;padding:15px clamp(18px,5vw,64px);display:flex;justify-content:space-between;align-items:center}.top a{color:#1769aa;text-decoration:none}.brand{font-size:19px;font-weight:750;color:#123354!important}.nav{display:flex;gap:16px;align-items:center}.wrap{max-width:940px;margin:34px auto;padding:0 22px}.wrap h1{margin-bottom:6px}.muted{color:#64748b}.card{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin:14px 0}.card h2{font-size:18px;margin:0 0 8px}.status{display:inline-block;background:#edf5fb;color:#245a82;border-radius:18px;padding:6px 10px;font-size:13px;margin-top:12px}.empty{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:24px;margin-top:20px}@media(max-width:500px){.top{align-items:flex-start;flex-direction:column;gap:12px}}
  </style>
</head>
<body>
  <header class="top"><a class="brand" href="/">Online Job Finder</a><nav class="nav"><span><%= user.name %></span><a href="/">Browse jobs</a><a href="/logout">Log out</a></nav></header>
  <main class="wrap"><h1>My applications</h1><p class="muted">Track the latest status of each application you submitted.</p>
    <% if (applications.length) { applications.forEach(application => { %>
      <article class="card">
        <h2><%= application.job ? application.job.title : 'Job listing removed' %></h2>
        <% if (application.job) { %><p class="muted"><%= application.job.companyName || '' %><% if (application.job.location) { %> · <%= application.job.location %><% } %><% if (application.job.type) { %> · <%= application.job.type %><% } %></p><% } %>
        <p class="muted">Submitted <%= application.submittedAt.toLocaleDateString() %></p>
        <span class="status">Status: <strong><%= application.status || 'Submitted' %></strong></span>
      </article>
    <% }); } else { %><div class="empty">You haven’t submitted any applications yet. <a href="/">Browse open jobs</a>.</div><% } %>
  </main>
</body>
</html>
