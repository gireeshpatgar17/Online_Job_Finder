<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login | Online Job Finder</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #007bff;
      --secondary-color: #0056b3;
      --background-color: #f5f9ff;
      --text-color: #333;
      --input-bg: #fff;
      --error-bg: #ffe6e6;
      --error-color: #e60000;
      --border-color: #ccc;
    }

    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: url('https://images.pexels.com/photos/4065876/pexels-photo-4065876.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1https://images.pexels.com/photos/4065876/pexels-photo-4065876.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1') no-repeat center center fixed;
      background-size: cover;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .auth-container {
      background-color: rgba(255, 255, 255, 0.3);
      /*backdrop-filter: blur(6px); */
      padding: 40px 30px;
      border-radius: 12px;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
      color: rgba(0, 0, 0, 0.75);
    }

    .auth-title {
      text-align: center;
      font-size: 28px;
      color: var(--primary-color);
      margin-bottom: 20px;
    }

    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .auth-form input,
    .auth-form select {
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 15px;
    }

    .auth-form input:focus {
      border-color: var(--primary-color);
      outline: none;
      box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
    }

    .auth-btn {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 12px;
      font-size: 16px;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.3s;
    }

    .auth-btn:hover {
      background-color: var(--secondary-color);
    }

    .auth-footer {
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
    }

    .auth-link {
      color: var(--primary-color);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-link:hover {
      text-decoration: underline;
    }

    .error-message {
      background-color: var(--error-bg);
      color: var(--error-color);
      padding: 10px;
      border-radius: 8px;
      text-align: center;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .error-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .shake {
      animation: shake 0.4s ease-in-out;
    }

    @keyframes shake {

      0%,
      100% {
        transform: translateX(0);
      }

      25% {
        transform: translateX(-5px);
      }

      50% {
        transform: translateX(5px);
      }

      75% {
        transform: translateX(-5px);
      }
    }

    /* Toast Notification - Black and White Theme */
    /* Toast Notification - Professional Blue */
    /* Toast Notification - Premium Transparent Effect */
   .toast-message {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--primary-color);
  color: #ffffff;
  padding: 12px 40px;
  border-radius: 30px;
  box-shadow: 0 8px 30px rgba(0, 123, 255, 0.6);
  font-weight: 600;
  font-size: 0.95rem;
  z-index: 1000;
  opacity: 1;
  transition: opacity 0.5s ease, top 0.5s ease;
}

.toast-message.toast-hide {
  top: 0;
  opacity: 0;
}

.toast-message:hover {
  background: var(--secondary-color);
  box-shadow: 0 12px 40px rgba(0, 86, 179, 0.7);
  transform: translateX(-50%) translateY(-2px);
}

  </style>
</head>

<body>

  <body>
    <% if (typeof message !== 'undefined' && message === 'loggedout') { %>

      <div class="toast-message" id="logout-toast">
        Logged out successfully. Please log in again to continue.
      </div>
      <% } %>


        <div class="auth-container">
          <h1 class="auth-title">Welcome Back</h1>

          <% if (typeof error !=='undefined' ) { %>
            <div class="error-message shake">
              <svg class="error-icon" viewBox="0 0 24 24">
                <path fill="currentColor"
                  d="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" />
              </svg>
              <%= error %>
            </div>
            <% } %>

              <form class="auth-form" action="/login" method="POST">
                <input type="text" name="username" placeholder="Username" required>
                <input type="password" name="password" placeholder="Password" required>
                <!--<select name="role" required>
        <option value="applicant">Job Seeker</option>
        <option value="recruiter">Recruiter</option>
      </select> -->
                <button type="submit" class="auth-btn">Login</button>
              </form>

              <p class="auth-footer">
                Don’t have an account? <a href="/signup" class="auth-link">Sign Up</a>
              </p>
        </div>
        <script>
          // Auto-hide the toast after 3 seconds
          window.addEventListener('load', () => {
            const toast = document.getElementById('logout-toast');
            if (toast) {
              setTimeout(() => {
                toast.classList.add('toast-hide');
              }, 2500); // 3 seconds
            }
          });
        </script>





  </body>

</html>