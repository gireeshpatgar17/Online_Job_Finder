<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Find Jobs | Online Job Finder</title>
  <style>
    :root{font-family:Inter,Segoe UI,Arial,sans-serif;color:#1e293b;background:#f4f7fb;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#1769aa;text-decoration:none}.topbar{background:#fff;border-bottom:1px solid #e4eaf0;padding:16px clamp(18px,5vw,72px);display:flex;justify-content:space-between;align-items:center;gap:18px}.brand{font-size:20px;font-weight:750;color:#123354}.nav{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.nav a{padding:9px 13px;border-radius:8px}.nav .primary{background:#1769aa;color:#fff}.nav .logout{border:1px solid #ccd8e3;color:#34495e}.page{max-width:1240px;margin:34px auto;padding:0 22px}.intro{margin:0 0 22px}.intro h1{font-size:30px;margin:0 0 6px}.intro p{color:#64748b;margin:0}.layout{display:grid;grid-template-columns:285px minmax(0,1fr);gap:22px}.filters,.listing{background:#fff;border:1px solid #e2e8f0;border-radius:13px}.filters{padding:19px;height:max-content}.filter-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.filter-head h2{font-size:18px;margin:0}.reset{border:0;background:none;color:#1769aa;cursor:pointer}.filter-group{padding:15px 0;border-top:1px solid #edf1f5}.filter-group h3{font-size:14px;margin:0 0 10px}.filter-option{display:flex;align-items:center;gap:8px;margin:10px 0;font-size:13px;color:#394b5e}.filter-option input{accent-color:#1769aa}.filter-option .facet-count{margin-left:auto;color:#8292a3}.search{width:100%;padding:12px 14px;border:1px solid #cbd5e1;border-radius:9px;margin:0 0 18px;font-size:15px}.listing{padding:20px}.listing-head{display:flex;justify-content:space-between;align-items:center;gap:14px;border-bottom:1px solid #e9eef3;padding-bottom:15px}.count{font-weight:650}.sort{display:flex;align-items:center;gap:8px;font-size:13px;color:#64748b}.sort select{padding:8px;border:1px solid #cbd5e1;border-radius:7px;background:#fff;color:#26384a}.job-list{display:grid;gap:13px;margin-top:16px}.job-card{border:1px solid #e4eaf0;border-radius:11px;padding:17px;display:grid;grid-template-columns:54px minmax(0,1fr);gap:14px}.job-card:hover{border-color:#b6d2e8;box-shadow:0 5px 18px #1639570d}.job-icon{width:48px;height:48px;object-fit:contain}.job-title{font-size:17px;margin:0 0 5px;color:#173c5b}.company{font-size:13px;color:#65758a}.description{font-size:13px;color:#53657a;line-height:1.5;margin:10px 0;white-space:pre-line;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.tags{display:flex;gap:7px;flex-wrap:wrap}.tag{background:#eef5fa;color:#365a78;border-radius:20px;padding:5px 9px;font-size:12px}.job-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:14px}.salary{font-size:13px;font-weight:650;color:#216344}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions a{font-size:12px;padding:8px 11px;border-radius:7px;border:1px solid #cbd8e3}.actions .apply{background:#1769aa;color:white;border-color:#1769aa}.empty{padding:50px 15px;text-align:center;color:#64748b}.pagination{display:flex;justify-content:center;align-items:center;gap:7px;margin-top:22px;flex-wrap:wrap}.pagination a,.pagination span{padding:8px 11px;border:1px solid #d6e0e9;border-radius:7px;background:#fff}.pagination .current{background:#1769aa;color:#fff;border-color:#1769aa}.pagination .disabled{color:#a0acb8;background:#f7f9fb}.hidden{display:none!important}
    @media(min-width:801px){html,body{height:100%;overflow:hidden}body{height:100vh;display:flex;flex-direction:column}.topbar{flex:none}.page{width:100%;flex:1;min-height:0;display:flex;flex-direction:column;margin:0 auto}#filters{flex:1;min-height:0;display:flex;flex-direction:column}.search{flex:none}.layout{flex:1;min-height:0;align-items:stretch}.filters,.listing{height:100%;min-height:0;overflow-y:auto;overscroll-behavior:contain}.filters{height:100%}}
    @media(max-width:800px){body{height:auto;overflow:auto}.layout{grid-template-columns:1fr}.filters{order:2;height:auto;overflow:visible}.listing{order:1;height:auto;overflow:visible}.page{margin:22px auto}.intro h1{font-size:25px}}@media(max-width:500px){.topbar{align-items:flex-start;flex-direction:column}.job-bottom{align-items:flex-start;flex-direction:column}.listing-head{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Online Job Finder</a>
    <nav class="nav" aria-label="Account">
      <% if (user && user.role === 'applicant') { %>
        <span>Hi, <%= user.name %></span><a href="/my-applications">My applications</a><a class="logout" href="/logout">Log out</a>
      <% } else if (!user) { %><a href="/login">Log in</a><a class="primary" href="/signup">Create account</a><% } %>
    </nav>
  </header>
  <main class="page">
    <section class="intro"><h1>Find your next opportunity</h1><p>Search active listings and narrow the results by employment, seniority, and annual salary.</p></section>
    <form id="filters" method="get" action="/">
      <input class="search" name="q" type="search" value="<%= query %>" placeholder="Search jobs by title, role, company, location, or description" aria-label="Search jobs">
      <div class="layout">
        <aside class="filters" aria-label="Job filters">
          <div class="filter-head"><h2>Filters</h2><a class="reset" href="/">Clear all</a></div>
          <section class="filter-group"><h3>Type of employment</h3>
            <% employmentOptions.forEach((option, i) => { %>
              <label class="filter-option"><input type="checkbox" name="employment" value="<%= option %>" <%= selectedEmployment.includes(option) ? 'checked' : '' %> onchange="this.form.requestSubmit()" id="employment-<%= i %>"><span><%= option %></span><span class="facet-count"><%= employmentCounts[option] || 0 %></span></label>
            <% }); %>
            <% if (!employmentOptions.length) { %><p class="company">No employment types yet.</p><% } %>
          </section>
          <section class="filter-group"><h3>Seniority level</h3>
            <% seniorityOptions.forEach((option, i) => { %>
              <label class="filter-option"><input type="checkbox" name="seniority" value="<%= option %>" <%= selectedSeniority.includes(option) ? 'checked' : '' %> onchange="this.form.requestSubmit()" id="seniority-<%= i %>"><span><%= option %></span><span class="facet-count"><%= seniorityCounts[option] || 0 %></span></label>
            <% }); %>
          </section>
          <section class="filter-group"><h3>Annual salary (INR)</h3>
            <% salaryBands.forEach((band, i) => { %>
              <label class="filter-option"><input type="checkbox" name="salary" value="<%= band.id %>" <%= selectedSalary.includes(band.id) ? 'checked' : '' %> onchange="this.form.requestSubmit()" id="salary-<%= i %>"><span><%= band.label %></span><span class="facet-count"><%= salaryCounts[band.id] || 0 %></span></label>
            <% }); %>
          </section>
        </aside>
        <section class="listing" aria-label="Job listings">
          <div class="listing-head">
            <div class="count" aria-live="polite">Showing <%= firstResult %>–<%= lastResult %> of <%= total %> <%= total === 1 ? 'job' : 'jobs' %></div>
            <label class="sort">Sort by
              <select name="sort" onchange="this.form.requestSubmit()">
                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest post</option>
                <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest post</option>
                <option value="salary" <%= sort === 'salary' ? 'selected' : '' %>>Salary (highest first)</option>
                <option value="daysLeft" <%= sort === 'daysLeft' ? 'selected' : '' %>>Days left (least first)</option>
              </select>
            </label>
          </div>
          <div class="job-list">
            <% jobs.forEach(job => { %>
              <article class="job-card">
                <a href="/jobs/<%= job._id %>" aria-label="View <%= job.title %>"><img class="job-icon" src="/images/<%= job.icon %>" alt=""></a>
                <div>
                  <h2 class="job-title"><a href="/jobs/<%= job._id %>"><%= job.title %></a></h2>
                  <div class="company"><%= job.companyName || (job.postedBy ? (job.postedBy.company || job.postedBy.name) : 'Company') %> · <%= job.role %><% if (job.location) { %> · <%= job.location %><% } %></div>
                  <p class="description"><%= job.description %></p>
                  <div class="tags"><span class="tag"><%= job.type %></span><% if (job.seniorityLevel) { %><span class="tag"><%= job.seniorityLevel %></span><% } %><% if (job.deadline) { %><span class="tag"><%= Math.max(0, Math.ceil((new Date(job.deadline).setHours(0,0,0,0) - new Date().setHours(0,0,0,0)) / 86400000)) %> days left</span><% } %></div>
                  <div class="job-bottom">
                    <span class="salary"><% if (Number.isFinite(job.salaryMin) && Number.isFinite(job.salaryMax)) { %>₹<%= (job.salaryMin / 100000).toLocaleString('en-IN', { maximumFractionDigits: 1 }) %>–<%= (job.salaryMax / 100000).toLocaleString('en-IN', { maximumFractionDigits: 1 }) %> LPA<% } else { %>Salary not disclosed<% } %></span>
                    <div class="actions">
                      <% if (!user) { %><a class="apply" href="/login?redirect=<%= encodeURIComponent('/apply?jobId=' + job._id) %>">Log in to apply</a><% } else if (user.role === 'applicant') { %><a class="apply" href="/apply?jobId=<%= job._id %>">Apply</a><% } %>
                      <a href="/contact/<%= job._id %>">Message recruiter</a>
                    </div>
                  </div>
                </div>
              </article>
            <% }); %>
            <% if (!jobs.length) { %><div class="empty">No active jobs match these filters.</div><% } %>
          </div>
          <% if (totalPages > 1) { %>
            <nav class="pagination" aria-label="Pagination">
              <% if (currentPage > 1) { %><a href="/?<%= paginationPrefix %>page=<%= currentPage - 1 %>">Previous</a><% } else { %><span class="disabled">Previous</span><% } %>
              <% const firstPage = Math.max(1, currentPage - 2); const finalPage = Math.min(totalPages, currentPage + 2); for (let pageNumber = firstPage; pageNumber <= finalPage; pageNumber++) { %>
                <% if (pageNumber === currentPage) { %><span class="current"><%= pageNumber %></span><% } else { %><a href="/?<%= paginationPrefix %>page=<%= pageNumber %>"><%= pageNumber %></a><% } %>
              <% } %>
              <% if (currentPage < totalPages) { %><a href="/?<%= paginationPrefix %>page=<%= currentPage + 1 %>">Next</a><% } else { %><span class="disabled">Next</span><% } %>
            </nav>
          <% } %>
        </section>
      </div>
    </form>
  </main>
  <script>
    const searchInput = document.querySelector('input[name="q"]');
    let searchTimer;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => searchInput.form.requestSubmit(), 450);
    });
  </script>
</body>
</html>
