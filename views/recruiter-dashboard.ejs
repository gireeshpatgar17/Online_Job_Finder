<!-- Purpose: Render recruiter-owned posts, applicant submissions, status controls, downloads, and messages. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Recruiter Dashboard | Online Job Finder</title>
  <style>
    :root{font-family:Inter,Segoe UI,Arial,sans-serif;color:#1e293b;background:#f4f7fb}*{box-sizing:border-box}body{margin:0}.top{background:#fff;border-bottom:1px solid #e2e8f0;padding:15px clamp(18px,5vw,64px);display:flex;justify-content:space-between;align-items:center}.brand{font-size:19px;font-weight:750;color:#123354;text-decoration:none}.nav{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.nav a{color:#1769aa;text-decoration:none}.nav .logout{padding:8px 12px;border:1px solid #ccd8e3;border-radius:8px;color:#34495e}.wrap{max-width:1180px;margin:30px auto;padding:0 22px}.heading{display:flex;justify-content:space-between;align-items:center;gap:16px}.heading h1{margin:0 0 5px;font-size:28px}.muted{color:#64748b}.button{display:inline-block;background:#1769aa;color:#fff!important;padding:11px 15px;border-radius:8px;text-decoration:none}.success{background:#e8f7ef;color:#17613b;border:1px solid #b7e3c9;border-radius:9px;padding:13px 16px;margin:20px 0}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin:23px 0}.metric,.panel{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:18px}.metric strong{display:block;font-size:26px;color:#173c5b}.metric span{color:#64748b;font-size:13px}.panel{margin:18px 0}.panel h2{font-size:19px;margin:0 0 15px}.job-row,.message-card,.application-card{padding:15px 0;border-top:1px solid #edf1f5}.job-row:first-of-type,.message-card:first-of-type,.application-card:first-of-type{border-top:0}.job-row{display:flex;justify-content:space-between;align-items:center;gap:15px}.job-row h3,.message-card h3,.application-card h3{font-size:15px;margin:0 0 6px}.tag{display:inline-block;background:#eef5fa;color:#365a78;padding:5px 8px;border-radius:20px;font-size:12px;margin:3px 5px 3px 0}.message-card.unread{border-left:3px solid #1769aa;padding-left:12px}.message-content{color:#53657a;white-space:pre-line}.actions{display:flex;gap:8px;align-items:center;margin-top:10px}.actions button,.actions a{font:inherit;font-size:13px;padding:7px 10px;border:1px solid #cbd8e3;border-radius:7px;background:white;color:#1769aa;text-decoration:none;cursor:pointer}.empty{color:#64748b;padding:15px 0}.file-links{display:flex;gap:12px;flex-wrap:wrap}.file-links a{font-size:13px;color:#1769aa}@media(max-width:650px){.metrics{grid-template-columns:1fr}.heading{align-items:flex-start;flex-direction:column}.job-row{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <header class="top"><a class="brand" href="/recruiter-dashboard">Recruiter Dashboard</a><nav class="nav"><span><%= user.company || user.name %></span><a href="/post-job">Post a job</a><a class="logout" href="/logout">Log out</a></nav></header>
  <main class="wrap">
    <div class="heading"><div><h1>Welcome, <%= user.name %></h1><div class="muted">Manage your job posts, applications, and recruiter messages.</div></div><a class="button" href="/post-job">+ Create job post</a></div>
    <% if (jobPosted) { %><div class="success" role="status">Your job was published successfully and is now listed for applicants.</div><% } %>
    <% if (jobUpdated) { %><div class="success" role="status">Your job post was updated.</div><% } %>
    <% if (jobDeleted) { %><div class="success" role="status">The job post and its attached applications were deleted.</div><% } %>
    <% if (jobStatusChanged) { %><div class="success" role="status">The job’s open/closed status was updated.</div><% } %>
    <section class="metrics" aria-label="Recruiter overview">
      <div class="metric"><strong><%= jobs.length %></strong><span>Jobs posted</span></div>
      <div class="metric"><strong><%= applications.length %></strong><span>Applications received</span></div>
      <div class="metric"><strong><%= messages.length %></strong><span>Job messages</span></div>
    </section>

    <section class="panel" id="my-jobs"><h2>Your job posts</h2>
      <% if (jobs.length) { jobs.forEach(job => { %>
        <article class="job-row" data-job-row data-job-id="<%= job._id %>"><div><h3><a href="/jobs/<%= job._id %>"><%= job.title %></a></h3><span class="tag"><%= job.isOpen === false ? 'Closed' : 'Open' %></span><span class="tag"><%= job.type %></span><span class="tag"><%= job.seniorityLevel || 'Seniority not set' %></span><span class="tag"><% if (Number.isFinite(job.salaryMin) && Number.isFinite(job.salaryMax)) { %>₹<%= (job.salaryMin / 100000).toLocaleString('en-IN', { maximumFractionDigits: 1 }) %>–<%= (job.salaryMax / 100000).toLocaleString('en-IN', { maximumFractionDigits: 1 }) %> LPA<% } else { %>Salary missing<% } %></span><div class="muted">Posted <%= job.createdAt.toLocaleDateString() %><% if (job.deadline) { %> · Deadline <%= job.deadline.toLocaleDateString() %><% } %></div></div><div class="actions"><a href="/jobs/<%= job._id %>">View</a><a href="/recruiter/jobs/<%= job._id %>/edit">Edit</a><button type="button" data-toggle-job data-open="<%= job.isOpen !== false %>"><%= job.isOpen === false ? 'Reopen' : 'Close' %></button><button type="button" data-delete-job>Delete</button></div></article>
      <% }); } else { %><p class="empty">You have not posted any jobs yet. Create your first listing to get started.</p><% } %>
    </section>

    <section class="panel" id="applications"><h2>Applications for your jobs</h2>
      <% if (applications.length) { applications.forEach(application => { %>
        <article class="application-card"><h3><%= application.name %> · <%= application.job ? application.job.title : 'Job application' %></h3><div class="muted"><%= application.email %> · <%= application.phone %></div><p><strong>Education:</strong> <%= application.degree %> in <%= application.specialization %> (<%= application.gradYear %>)</p><p><strong>Experience:</strong> <%= application.experienceYears || 0 %> years · <strong>Skills:</strong> <%= application.skills %></p><% if (application.keyResponsibilities) { %><p><strong>Experience details:</strong> <%= application.keyResponsibilities %></p><% } %><label>Application status <select data-application-status data-app-id="<%= application._id %>"><% ['Submitted','Under Review','Interview','Rejected','Accepted'].forEach(status => { %><option value="<%= status %>" <%= (application.status || 'Submitted') === status ? 'selected' : '' %>><%= status %></option><% }); %></select></label><div class="file-links"><% if (application.resume) { %><a href="/applications/<%= application._id %>/files/resume">Download resume</a><% } %><% (application.certificates || []).forEach((file, i) => { %><a href="/applications/<%= application._id %>/files/certificate/<%= i %>">Certificate <%= i + 1 %></a><% }); %></div></article>
      <% }); } else { %><p class="empty">No applications have arrived for your jobs yet.</p><% } %>
    </section>

    <section class="panel" id="messages"><h2>Messages from applicants</h2>
      <% if (messages.length) { messages.forEach(message => { %>
        <article class="message-card <%= message.status === 'unread' ? 'unread' : '' %>" data-message-id="<%= message._id %>">
          <h3><%= message.job ? message.job.title : 'Job inquiry' %></h3><div class="muted">From <%= message.sender.name %> · <%= message.sender.email %> · <%= message.createdAt.toLocaleDateString() %></div><p class="message-content"><%= message.message %></p>
          <div class="actions"><a href="mailto:<%= message.sender.email %>">Reply by email</a><% if (message.status === 'unread') { %><button type="button" data-read-message>Mark read</button><% } %><button type="button" data-delete-message>Delete</button></div>
        </article>
      <% }); } else { %><p class="empty">No messages yet.</p><% } %>
    </section>
  </main>
  <script>
    document.querySelectorAll('[data-toggle-job]').forEach(button => button.addEventListener('click', async () => {
      const row = button.closest('[data-job-row]');
      const response = await fetch(`/recruiter/jobs/${row.dataset.jobId}/open`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ isOpen: button.dataset.open !== 'true' }) });
      if (response.ok) location.href = '/recruiter-dashboard?statusChanged=1';
      else { const result = await response.json(); alert(result.error || 'Could not update this job.'); }
    }));
    document.querySelectorAll('[data-delete-job]').forEach(button => button.addEventListener('click', async () => {
      if (!confirm('Delete this job and permanently remove its applications, uploaded documents, and messages?')) return;
      const row = button.closest('[data-job-row]');
      const response = await fetch(`/recruiter/jobs/${row.dataset.jobId}`, { method: 'DELETE' });
      if (response.ok) location.href = '/recruiter-dashboard?deleted=1';
      else alert('Could not delete this job. Please refresh and try again.');
    }));
    document.querySelectorAll('[data-application-status]').forEach(select => select.addEventListener('change', async () => {
      const response = await fetch(`/applications/${select.dataset.appId}/status`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status: select.value }) });
      if (!response.ok) { alert('Could not update application status.'); location.reload(); }
    }));
    document.querySelectorAll('[data-read-message]').forEach(button => button.addEventListener('click', async () => {
      const card = button.closest('[data-message-id]');
      const response = await fetch(`/messages/${card.dataset.messageId}/read`, { method: 'PUT' });
      if (response.ok) { card.classList.remove('unread'); button.remove(); }
    }));
    document.querySelectorAll('[data-delete-message]').forEach(button => button.addEventListener('click', async () => {
      const card = button.closest('[data-message-id]');
      const response = await fetch(`/messages/${card.dataset.messageId}`, { method: 'DELETE' });
      if (response.ok) card.remove();
    }));
  </script>
</body>
</html>
