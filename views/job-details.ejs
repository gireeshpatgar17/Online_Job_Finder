<!-- Purpose: Show a job's full details and the actions available for its open/closed state. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= job.title %> | Online Job Finder</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body{font-family:Arial,sans-serif;background:#f4f7fb;color:#1d2939;margin:0;padding:32px}
    .job-detail{max-width:850px;margin:32px auto;background:#fff;border-radius:16px;padding:32px;box-shadow:0 10px 35px #19324d18}
    .job-detail img{width:50px;height:50px;object-fit:contain}.job-detail h1{margin:14px 0 8px}.meta{color:#536579;display:flex;gap:18px;flex-wrap:wrap}
    .actions{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap}.actions a{padding:12px 18px;border-radius:8px;background:#1769aa;color:#fff;text-decoration:none}.actions a.secondary{background:#e8f0f7;color:#164f7e}
  </style>
</head>
<body>
  <main class="job-detail">
    <a href="/">← Back to jobs</a>
    <% if (user) { %><span style="float:right"><%= user.name %> · <a href="/logout">Log out</a></span><% } %>
    <p><img src="/images/<%= job.icon %>" alt=""></p>
    <h1><%= job.title %></h1>
    <div class="meta"><span><%= job.role %></span><span><%= job.type %></span><span>Deadline: <%= job.deadline ? job.deadline.toLocaleDateString() : 'Not specified' %></span></div>
    <p><strong>Seniority:</strong> <%= job.seniorityLevel || 'Not specified' %></p>
    <% if (job.location) { %><p><strong>Location:</strong> <%= job.location %></p><% } %>
    <p><strong>Annual salary:</strong> <% if (Number.isFinite(job.salaryMin) && Number.isFinite(job.salaryMax)) { %>₹<%= (job.salaryMin / 100000).toLocaleString('en-IN', { maximumFractionDigits: 1 }) %>–<%= (job.salaryMax / 100000).toLocaleString('en-IN', { maximumFractionDigits: 1 }) %> LPA<% } else { %>Not disclosed<% } %></p>
    <p><strong>Posted by:</strong> <%= job.postedBy ? (job.postedBy.company || job.postedBy.name) : 'Recruiter' %></p>
    <h2>About this role</h2>
    <p style="white-space:pre-line"><%= job.description %></p>
    <% if (!acceptingApplications) { %><p><strong>This listing is closed.</strong></p><% } else if (!user || user.role === 'applicant') { %><div class="actions"><a href="<%= !user ? '/login?redirect=' + encodeURIComponent('/apply?jobId=' + job._id) : '/apply?jobId=' + job._id %>">Apply now</a><a class="secondary" href="/contact/<%= job._id %>">Message recruiter</a></div><% } %>
  </main>
</body>
</html>
